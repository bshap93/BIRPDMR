  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Congratulations and welcome to your new home! We hope your pre-fabricated
    BrightHope(TM) mobile prospecting outpost is to your liking. We are pleased to
    have you as our eighth customer here on L 98-59 b. \n\nAs with your peers, your
    outpost was built on top of an older outpost of the pre-war terraforming era.
    Of course, that failed terraforming attempt did change the landscape quite a
    bit, and anything of theirs is now below the new surface of the planet. \n\nYou're
    encouraged to dig and find any artifacts from that bygone era and of course,
    mine for resources. We will happily compensate you for each artifact and of course
    pay you for the valuable items you mine. \n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: baf5990ef136e594abc52299c06d9b48, type: 2}
